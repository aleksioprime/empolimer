# Скопируйте в .env (локально) или задайте в Coolify (продакшн).

# PostgreSQL
POSTGRES_USER=empolimer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=empolimer
TZ=Europe/Moscow

# Подключение бэкенда и воркера к PostgreSQL (в prod-compose задаётся из POSTGRES_*)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=empolimer
DB_USER=empolimer
DB_PASSWORD=change-me

# Redis — отозванные refresh-токены
REDIS_HOST=redis
REDIS_PORT=6379

# JWT: длинная случайная строка, например `openssl rand -hex 32`
JWT_SECRET_KEY=change-me

# Источники запросов к API, через запятую (фронтенд и API на одном домене — можно не задавать)
CORS_ALLOW_ORIGINS=http://localhost:8202

# Границы нормы по умолчанию (у каждого устройства можно задать свои в веб-интерфейсе)
DEFAULT_TEMP_MIN=18
DEFAULT_TEMP_MAX=28
DEFAULT_HUM_MIN=40
DEFAULT_HUM_MAX=70

# MQTT-брокер для воркера (локально — mosquitto из docker-compose.yaml)
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Новый формат и старые прошивки (devices/<id>/air)
MQTT_TOPICS=empolimer/+/data,empolimer/+/status,devices/+/air
# Новые устройства появляются в веб-интерфейсе сами при первом сообщении
AUTO_REGISTER_DEVICES=true
